# ─── مهیار گپ — متغیرهای محیطی ───
# این فایل فقط نمونه است؛ مقادیر واقعی رو توی Railway → Variables بذار.
# فایل .env رو هیچ‌وقت توی گیت‌هاب کامیت نکن (توی .gitignore هست).

# دیتابیس PostgreSQL (توی Railway می‌تونی از متغیر خود سرویس Postgres استفاده کنی)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# کلید امضای توکن‌های ورود — یه رشته‌ی طولانی و تصادفی
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"

# LiveKit (برای ویس و اسکرین‌شیر)
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"
LIVEKIT_URL="wss://your-project.livekit.cloud"

# محیط اجرا — روی Railway این رو توی داشبورد Variables بذار: NODE_ENV=production
# (توی .env لوکال نذارش چون Vite اجازه نمی‌ده)

# اختیاری: اگه بخوای ثبت‌نام فقط با کد باشه، این رو ست کن (مثلا کدت بین رفیق‌ها)
# INVITE_CODE="mahyar-gap"
